# Microsoft Entra
CLIENT_ID=
# Configure exactly one of CLIENT_SECRET or CLIENT_CERT_PATH.
CLIENT_SECRET=
CLIENT_CERT_PATH=
CLIENT_CERT_THUMBPRINT=
# The same App Registration is both the MCP resource and the interactive
# confidential OAuth client. Register OAUTH_ISSUER_URL + /oauth/callback as Web.

# Optional explicit audience. Leave empty to accept CLIENT_ID and api://CLIENT_ID.
AUDIENCE=
# Comma-separated tenant IDs, or * to accept any valid Microsoft tenant.
# Personal Microsoft accounts are accepted only if the App Registration supports them.
# Leave empty to fail closed.
ALLOWED_TENANTS=
REQUIRED_SCOPES=access_as_user

# HTTP listener.
MCP_HOST=0.0.0.0
MCP_PORT=8000
MCP_BIND_ADDRESS=127.0.0.1

# OAuth discovery, DCR, authorization-code and refresh flows remain disabled
# until real WorkBuddy acceptance is complete.
OAUTH_ENABLED=false
MCP_PUBLIC_URL=https://mcp.example.com/mcp/
OAUTH_ISSUER_URL=https://mcp.example.com
OAUTH_DATABASE_PATH=/data/oauth.db
OAUTH_TRANSACTION_TTL_SECONDS=600
OAUTH_AUTHORIZATION_CODE_TTL_SECONDS=600
# Base64 encoding of exactly 32 random bytes. Required when OAUTH_ENABLED=true.
OAUTH_ENCRYPTION_KEY=
OAUTH_REFRESH_TOKEN_TTL_DAYS=30
OAUTH_REFRESH_MAX_ROTATIONS=10000

# Set only after the version exists in GHCR; no initial release is implied.
M365_MCP_IMAGE=ghcr.io/sagehou/m365-mcp-server:CHANGE_ME

# Explicit delegated scopes shown on the user's interactive consent screen.
GRAPH_CONSENT_SCOPES=https://graph.microsoft.com/User.Read,https://graph.microsoft.com/Mail.ReadWrite
# Microsoft Graph OBO resource scope. Do not mix .default with explicit scopes here.
GRAPH_SCOPES=https://graph.microsoft.com/.default
GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
GRAPH_MAX_RETRIES=3
GRAPH_RETRY_BACKOFF_SECONDS=0.5
GRAPH_MAX_RETRY_DELAY_SECONDS=30
GRAPH_MAX_RESPONSE_BYTES=16777216
HTTP_TIMEOUT_SECONDS=10

# Attachment extraction limits.
ATTACHMENT_MAX_BYTES=10485760
ATTACHMENT_MAX_TEXT_CHARS=100000
# Single-process, in-memory attachment download tickets.
ATTACHMENT_DOWNLOAD_TTL_SECONDS=300
ATTACHMENT_DOWNLOAD_MAX_ITEMS=16
# Must be greater than or equal to ATTACHMENT_MAX_BYTES.
ATTACHMENT_DOWNLOAD_MAX_TOTAL_BYTES=67108864
