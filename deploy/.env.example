# Microsoft Entra
TENANT_ID=
CLIENT_ID=
# Configure exactly one of CLIENT_SECRET or CLIENT_CERT_PATH.
CLIENT_SECRET=
CLIENT_CERT_PATH=
CLIENT_CERT_THUMBPRINT=

# The audience of the access token issued to this API.
AUDIENCE=
ALLOWED_TENANTS=
REQUIRED_SCOPES=access_as_user

# OAuth
MCP_PUBLIC_URL=https://mcp.example.com

# Security
LOG_LEVEL=INFO

# Microsoft Graph OBO resource scope.
GRAPH_SCOPES=https://graph.microsoft.com/.default
GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
GRAPH_MAX_RETRIES=3
GRAPH_RETRY_BACKOFF_SECONDS=0.5
GRAPH_MAX_RETRY_DELAY_SECONDS=30

# Attachment extraction limits.
ATTACHMENT_MAX_BYTES=10485760
ATTACHMENT_MAX_TEXT_CHARS=100000
